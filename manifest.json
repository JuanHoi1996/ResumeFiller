{
  "manifest_version": 3,
  "name": "ResumeFiller",
  "version": "2.2.4",
  "description": "Open-source resume autofill assistant for job applications",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "contextMenus",
    "clipboardWrite"
  ],
  "icons": {
    "16": "icons/active/icon16.png",
    "32": "icons/active/icon32.png",
    "48": "icons/active/icon48.png",
    "128": "icons/active/icon128.png"
  },
  "action": {
    "default_title": "ResumeFiller",
    "default_icon": {
      "16": "icons/active/icon16.png",
      "32": "icons/active/icon32.png",
      "48": "icons/active/icon48.png",
      "128": "icons/active/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["storage.js", "data.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}

